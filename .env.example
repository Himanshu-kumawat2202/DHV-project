# Environment Configuration for NIRF Insights
# Secure backend configuration - never expose to client bundle

# GEMINI_API_KEY: API key for Gemini LLM question understanding and explanatory generation
GEMINI_API_KEY="your_api_key_here"

# GEMINI_MODEL: Model identifier for Gemini API (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# LLM_TIMEOUT_MS: Maximum time in milliseconds to wait for LLM API before falling back to deterministic engine
LLM_TIMEOUT_MS="5000"

# APP_URL: Base URL where the dashboard is hosted
APP_URL="http://localhost:3000"
